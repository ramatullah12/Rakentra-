{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build && mkdir -p dist",
    "functions": {
        "api/index.php": { "runtime": "vercel-php@0.7.4" }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/css/(.*)",
            "dest": "/public/css/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/public/images/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/public/js/$1"
        },
        {
            "src": "/vendors/(.*)",
            "dest": "/public/vendors/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_KEY": "base64:LZk+rgo7va6kRDj8ksFpEs+tVmedjhW+1qRDzYQVwYs=",
        "APP_URL": "https://rakentra-git-main-yuan-ramatullahs-projects.vercel.app",
        "ASSET_URL": "https://rakentra-git-main-yuan-ramatullahs-projects.vercel.app",

        "DB_CONNECTION": "mysql",
        "DB_HOST": "bpvjrridkqchje8pmg1w-mysql.services.clever-cloud.com",
        "DB_PORT": "3306",
        "DB_DATABASE": "bpvjrridkqchje8pmg1w",
        "DB_USERNAME": "ucdcsycivznixidn",
        "DB_PASSWORD": "MqrUeDZZkLJIoaLJOW6a",

        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",

        "CACHE_DRIVER": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie"
    }
}